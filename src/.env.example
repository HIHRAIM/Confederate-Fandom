# Copy to src/.env and fill in. The real file is untracked and must stay so:
# it holds the bot token and the wiki bot password.
#
# The Telegram bot token, from @BotFather.
TELEGRAM_BOT_TOKEN=
# The wiki account and its BotPassword (Special:BotPasswords on the wiki).
# WIKI_BOT_PASSWORD_SUFFIX is the name of the BotPassword, not the account:
# the bot logs in as "<WIKI_USERNAME>@<WIKI_BOT_PASSWORD_SUFFIX>".
WIKI_USERNAME=
WIKI_BOT_PASSWORD_SUFFIX=
WIKI_BOT_PASSWORD=
# The key the database backups are encrypted with. Any long random string;
# THIS project's own, not another bot's. Without it the bot still runs and
# simply makes no backups — it never writes an unencrypted one instead.
# Keep a copy somewhere other than this server: lose the key and every
# backup already made is unreadable for good.
BACKUP_KEY=
